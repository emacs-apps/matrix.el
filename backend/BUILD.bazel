load("@matrix_backend_crates//:data.bzl", "DEP_DATA")
load("@matrix_backend_crates//:defs.bzl", "aliases", "all_crate_deps", "all_crate_features")
load("@rules_rust//rust:defs.bzl", "rust_binary")

_CRATE = DEP_DATA[package_name()]

exports_files(
    [
        "Cargo.toml",
        "Cargo.lock",
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "matrix-backend",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = all_crate_features(),
    crate_name = _CRATE["crate_name"],
    crate_root = "src/main.rs",
    edition = _CRATE["edition"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    version = _CRATE["version"],
    visibility = ["//wdoom:__pkg__"],
    deps = all_crate_deps(normal = True),
)
